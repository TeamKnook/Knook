# Local preview API only. Do not use this service as production backend.
DEMO_MODE=true
DEMO_OTP_CODE=123456
JWT_SECRET=replace-with-local-secret

# Authentication mode
# preview = temporary local JWT flow
# firebase = verify Firebase ID tokens using Firebase Admin SDK
AUTH_MODE=preview
FIREBASE_PROJECT_ID=knook-development
GOOGLE_APPLICATION_CREDENTIALS=/absolute/local/path/to/firebase-admin.json

# MongoDB used by the temporary preview API
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=knook_preview
