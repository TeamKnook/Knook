# Local preview API
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
EXPO_PUBLIC_DEMO_MODE=true

# Firebase client configuration
EXPO_PUBLIC_FB_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FB_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FB_PROJECT_ID=your_project_id
EXPO_PUBLIC_FB_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FB_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FB_APP_ID=your_firebase_app_id

# Branch deep links
EXPO_PUBLIC_BRANCH_KEY=your_branch_key

